# Copy to .env.local. Never commit populated credentials.
# Scope deployment secrets to the processes that need them.
# No Neon configuration is required.

# PostgreSQL: runner, gateway, CLI, dashboard.
# Use a dedicated database/user. For remote TLS, use sslmode=verify-full.
DATABASE_URL=postgresql://factory:change-me@127.0.0.1:5432/factory
# Direct connection for explicit migrations (not a transaction pooler).
DATABASE_URL_UNPOOLED=postgresql://factory:change-me@127.0.0.1:5432/factory
# Set only when intentionally migrating a protected production target.
# FACTORY_MIGRATION_TARGET=production

# Hosted gateway: publicly reachable even when runner/dashboard are offline.
FACTORY_GATEWAY_URL=https://gateway.example.com
# Gateway listening port. Not the dashboard's port.
# PORT=3008
# Generate independent secrets, for example: openssl rand -hex 32
FACTORY_INGEST_SECRET=
LINEAR_WEBHOOK_SECRET=
GITHUB_APP_WEBHOOK_SECRET=

# Linear: dashboard/CLI filing and gateway source integration.
LINEAR_API_KEY=
FACTORY_TEAM_KEY=FAC
FACTORY_LABEL=factory

# GitHub App: hosted processes without the local GitHub App file.
# Local setup normally uses ~/.config/marshal-factory/github-app.json instead.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Optional dashboard: exact browser origin, no path.
# Production requires HTTPS. HTTP is allowed only for localhost/SSH tunnel access.
FACTORY_DASHBOARD_URL=http://localhost:3000
# Links in Slack; leave empty for a headless deployment.
FACTORY_PANEL_URL=
# Only enable when your trusted proxy overwrites this header with the client IP.
# Without it, login throttling uses a conservative shared network bucket.
# FACTORY_CLIENT_IP_HEADER=x-real-ip
# Owner accounts/passwords live in PostgreSQL, not environment variables.
# After migrations: bun run cli owners create --input '{"email":"you@example.com"}'
# Password is prompted without echo. No public signup or email reset.

# Optional Slack: gateway handles signed requests; runner sends notifications.
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# SLACK_OWNER_USER_ID=
# Existing Slack action attribution uses the first address in this list.
# This does NOT grant dashboard access; dashboard uses local owner accounts.
# FACTORY_OWNER_EMAILS=you@example.com

# Optional Modal sandbox execution: runner and secret provisioning.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# Claude sandbox authentication, when using that harness.
# CLAUDE_CODE_OAUTH_TOKEN=

# Optional local path overrides. Omit to use defaults; do not set empty values.
# MARSHAL_FACTORY_ENV=/absolute/path/to/factory.env
# MARSHAL_FACTORY_CONFIG=/absolute/path/to/config.json
# MARSHAL_FACTORY_GITHUB_APP=/absolute/path/to/github-app.json
# MARSHAL_FACTORY_SANDBOX_IMAGE=/absolute/path/to/sandbox-image.json
# T3CODE_CLI_PATH=/absolute/path/to/t3
# T3CODE_HOME=/absolute/path/to/.t3
# CODEX_HOME=/absolute/path/to/.codex

# Runner config.json is separate: linearApiKey, ingestUrl, secret, factory settings.
# Its ingestUrl must be FACTORY_GATEWAY_URL + /ingest;
# its secret must match FACTORY_INGEST_SECRET.
