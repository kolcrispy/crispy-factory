# Copy to .env.local. Never commit populated credentials.
# Runner, CLI, and optional dashboard share a dedicated fresh PostgreSQL database.
# Remote connections require verified TLS, for example sslmode=verify-full.
DATABASE_URL=postgresql://factory:change-me@127.0.0.1:5432/factory
# Explicit migrations require a direct connection, not a transaction pooler.
DATABASE_URL_UNPOOLED=postgresql://factory:change-me@127.0.0.1:5432/factory
# Set only when intentionally migrating a protected production target.
# FACTORY_MIGRATION_TARGET=production

# Optional dashboard origin. Production requires HTTPS; localhost may use HTTP.
FACTORY_DASHBOARD_URL=http://localhost:3000
# Trust only a header your reverse proxy overwrites.
# FACTORY_CLIENT_IP_HEADER=x-real-ip
# Owner accounts live in PostgreSQL. No public signup or email reset.
# bun run cli owners create --input '{"email":"you@example.com"}'

# Optional native paths. Omit to use defaults; do not set empty values.
# CRISPY_FACTORY_ENV=/absolute/path/to/factory.env
# CRISPY_FACTORY_CONFIG=/absolute/path/to/config.json
# T3CODE_CLI_PATH=/absolute/path/to/t3
# T3CODE_HOME=/absolute/path/to/.t3
# CODEX_HOME=/absolute/path/to/.codex
# FACTORY_OMP_PATH=/absolute/path/to/omp

# Runner config.json separately holds ingestUrl, secret, and factory settings.
# ingestUrl must be HTTP loopback, for example http://127.0.0.1:3008/ingest.
# Generate a secret with at least 32 characters; never expose this endpoint publicly.
# Authenticate gh and your selected runtime (T3 or direct OMP) on the runner machine.
# No GitHub token belongs on a remote dashboard.
