{
  "name": "marshal-factory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run --cwd apps/dashboard dev",
    "build": "bun run --cwd apps/dashboard build",
    "start": "bun run --cwd apps/dashboard start",
    "lint": "eslint",
    "test:regressions": "bun scripts/test-postgres.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate-guard.ts && drizzle-kit migrate",
    "cli": "bun apps/cli/src/index.ts",
    "build:backend": "bun run --filter @factory/runner --filter @factory/cli build"
  },
  "devDependencies": {
    "@factory/core": "workspace:*",
    "@factory/integrations": "workspace:*",
    "@factory/platform": "workspace:*",
    "@factory/reporting": "workspace:*",
    "@factory/runner": "workspace:*",
    "@factory/storage": "workspace:*",
    "@types/bun": "latest",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "zod": "^4.6.7"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
